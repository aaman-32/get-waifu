{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "get-waifu",
    "compatibility_date": "2026-11-19",
    "main": "./api/index.ts",
    "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": [
            "/api/*"
        ],
        "directory": "dist/"
    }
}