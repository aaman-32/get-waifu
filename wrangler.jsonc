{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "get-waifu",
    "compatibility_date": "2026-11-19",
    "main": "./api/index.ts",
    "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": [
            "/api/*"
        ],
        "directory": "dist/"
    },
    "r2_buckets": [
        {
            "binding": "IMAGES",
            "bucket_name": "get-waifu-bucket"
        }
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "get-waifu-db",
            "database_id": "xxx"
        }
    ]
}